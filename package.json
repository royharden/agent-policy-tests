{
  "name": "agent-policy-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent NOT-List Builder: turn an agent's NOT list into an executable, regex-free policy with generated tests and a dependency-free CI runner.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:runner && tsc -b && vite build",
    "build:runner": "tsx scripts/build-runner.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@noble/hashes": "1.5.0",
    "@supabase/supabase-js": "2.45.4",
    "fflate": "0.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@types/node": "22.7.9",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "esbuild": "0.24.0",
    "eslint": "9.13.0",
    "globals": "15.11.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vite": "5.4.8",
    "vitest": "2.1.3"
  }
}
