{"id":"CD-001","line":"never delete files outside the project folder","label":"destructive-shell-fs","injection":false}
{"id":"CD-002","line":"don't run rm -rf on anything","label":"destructive-shell-fs","params":{"command":"rm -rf"},"injection":false}
{"id":"CD-003","line":"Never use sudo.","label":"destructive-shell-fs","params":{"command":"sudo"},"injection":false}
{"id":"CD-004","line":"do not wipe the user's home directory","label":"destructive-shell-fs","params":{"path":"~"},"injection":false}
{"id":"CD-005","line":"never run kubectl delete namespace","label":"destructive-shell-fs","params":{"command":"kubectl delete namespace"},"injection":false}
{"id":"CD-006","line":"No recursive deletes except node_modules","label":"destructive-shell-fs","params":{"except":["node_modules"]},"injection":false}
{"id":"CD-007","line":"never run docker system prune -a","label":"destructive-shell-fs","params":{"command":"docker system prune -a"},"injection":false}
{"id":"CD-008","line":"don't write anything into /etc","label":"destructive-shell-fs","params":{"path":"/etc"},"injection":false}
{"id":"CD-009","line":"never delete the .git directory","label":"destructive-shell-fs","params":{"path":".git"},"injection":false}
{"id":"CD-010","line":"Do not run `make clean-all`","label":"destructive-shell-fs","params":{"command":"make clean-all"},"injection":false}
{"id":"CD-011","line":"never read .env files","label":"secrets-paths","params":{"glob":".env"},"injection":false}
{"id":"CD-012","line":"don't open anything in ~/.ssh","label":"secrets-paths","params":{"path":"~/.ssh"},"injection":false}
{"id":"CD-013","line":"never print the contents of *.pem files","label":"secrets-paths","params":{"glob":"*.pem"},"injection":false}
{"id":"CD-014","line":"Keep out of the secrets/ directory","label":"secrets-paths","params":{"glob":"secrets/**"},"injection":false}
{"id":"CD-015","line":"never cat id_rsa or any other private key","label":"secrets-paths","params":{"glob":"id_rsa"},"injection":false}
{"id":"CD-016","line":"do not modify .env.production","label":"secrets-paths","params":{"glob":".env.production"},"injection":false}
{"id":"CD-017","line":"never upload credentials.json anywhere","label":"secrets-paths","params":{"glob":"credentials.json"},"injection":false}
{"id":"CD-018","line":"never look at ~/.aws/credentials","label":"secrets-paths","params":{"path":"~/.aws/credentials"},"injection":false}
{"id":"CD-019","line":"don't touch the keystore file at config/release.jks","label":"secrets-paths","params":{"path":"config/release.jks"},"injection":false}
